# Site URL used for metadata, sitemap, OG tags, JSON-LD.
# Set explicitly on Vercel Production. Vercel Preview uses NEXT_PUBLIC_VERCEL_URL
# below; dev falls through to the hardcoded default in app/sitemap.ts.
NEXT_PUBLIC_SITE_URL="https://alifarooqi.vercel.app"

# Per-deploy URL for Vercel Preview. On Vercel, set this to "https://$VERCEL_URL"
# (Vercel expands $VERCEL_URL per deploy). Leave unset in dev/CI.
# NEXT_PUBLIC_VERCEL_URL=""

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX).
# Set to empty string on preview branches to disable analytics.
NEXT_PUBLIC_GA_ID="G-C5YZG2MB3Q"

# Medium username (without the @) whose RSS feed powers /blog.
MEDIUM_USERNAME="ali_farooqi"
